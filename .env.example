# 服务端口
PORT=8787

# SQLite 数据库文件位置（相对路径基于 server 工作目录）
DB_PATH=../data/mealtime.db

# 时区（用于截单时间判断与日期归属）
TZ=Asia/Shanghai

# ------------------------------ 反向代理（可选） ------------------------------
# 反向代理（tailscale serve / nginx 等）部署时设为 1：AI 接口按 X-Forwarded-For
# 里的真实客户端 IP 记限流，避免一家人共享代理 IP 被算成同一个来源。
# 只在确有反代时开启；直连暴露时开启会允许伪造该头绕过按 IP 限流。见 deploy/tailscale.md。
# TRUST_PROXY=1

# 手机推送通知统一走家里的推送网关（PushPlus），所以这里只配网关地址；
# 是否开启仍在 App「设置 → 通知」里，Bark / ServerChan 已移除。
# 默认 http://127.0.0.1:8655/notify；容器部署时改成容器可达的宿主地址（如
# http://host.docker.internal:8655/notify，需 compose 配 extra_hosts）。
# PUSH_GATEWAY_URL=http://127.0.0.1:8655/notify

# ------------------------------ AI 加菜（可选） ------------------------------
# 不填 DEEPSEEK_API_KEY = 功能整体关闭，前端隐藏入口，点菜下单等主流程零影响。
# 隐私说明：启用后，你输入的文本、菜品反馈原文会发送给第三方模型服务；
# 成员姓名会在服务端替换为「成员A/B」等代号，但请避免在反馈里填写身份证、住址等敏感信息。
# 本文件只是模板：真实 key 写进 .env（已被 .gitignore 忽略，发布时也不会同步到 NAS）。
DEEPSEEK_API_KEY=
# 模型名，默认 deepseek-flash（加菜是填空式任务，快模型足够且省钱）
AI_MODEL=deepseek-flash
# 接口地址，默认 https://api.deepseek.com（OpenAI 兼容格式）
# AI_BASE_URL=https://api.deepseek.com
# 置 false 可在保留 key 的前提下临时关掉入口
# AI_ENABLED=false

# ------------------------------ 语音输入（可选） ------------------------------
# 首页「AI 帮手」里的「按住说话」由服务端转发到语音网关，token 只在服务端。
# 不填 = 暂时不可用（按钮仍在，点按后提示「语音服务暂时不可用，可以直接打字」）。
# NAS 部署时由 deploy/deploy-nas.sh 从 /mnt/mypool/voicegw/clients.env 的
# MEAL_TOKEN 读取并注入，不需要写进本文件；本机手动运行时才填。
VOICEGW_TOKEN=
# 语音网关地址，默认 http://192.0.2.10:8644（文档保留地址，示例用）
# VOICEGW_URL=http://192.0.2.10:8644

# ------------------------------ 自动快照备份（默认开启） ------------------------------
# 每天在 DB_PATH 同级的 auto-backup/ 生成一份 VACUUM INTO 一致快照，并与 uploads/ 图片镜像成对保存。
# 关闭：BACKUP_ENABLED=false
# 本地保留天数，默认 30，最小 1
# BACKUP_KEEP_DAYS=30
# 启动后延迟多久做首次快照（毫秒），默认 60000；测试时可调小
# BACKUP_STARTUP_DELAY_MS=60000
